# The dd-web container: the built frontend and /api, over plain HTTP.
#
# HTTPS is not handled here. The droplet's edge proxy (~/projects/edge-proxy) owns the
# certificate for dd.lazys.net and forwards requests to this container.

{
	servers {
		# Keep the client address and scheme the edge proxy passes along.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API. The /api prefix is the frontend's convention; the backend
	# itself serves from the root, so it is stripped here.
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# Everything else is the single-page app: a real file if there is one
	# (JavaScript, images, map pins), otherwise index.html so that a deep link
	# like /member/12 loads the app and lets its router take over.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Fingerprinted build output never changes; the page that points at it
		# must always be fetched fresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page path /index.html /
		header @page Cache-Control "no-cache"
	}
}
