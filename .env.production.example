# Settings for the production deployment. Copy to .env.production, fill in,
# and keep the copy out of git (it is ignored). deploy/deploy.sh copies it to
# the droplet as /opt/dd/.env (readable by root only).

# The droplet, as ssh reaches it (used by deploy/deploy.sh only).
DEPLOY_HOST=root@203.0.113.10
# Folder on the droplet (default /opt/dd).
# DEPLOY_DIR=/opt/dd

# Optional: push images through a registry, e.g.
# registry.digitalocean.com/<your registry name>. Only changed layers are sent.
# Leave unset to copy the whole images to the droplet over SSH on each deploy.
# DOCR_REGISTRY=registry.digitalocean.com/your-registry

# Database. Choose a long random password (e.g. openssl rand -base64 32); the
# database is not reachable from outside the stack, but treat this as a secret.
DATABASE_USER=dd
DATABASE_PASSWORD=change-me-to-a-long-random-string
DATABASE_NAME=dd

# Optional: Google sign-in client id. Built into the frontend image and checked
# by the backend. Add https://dd.lazys.net to the client's Authorized
# JavaScript origins in Google Cloud Console. Leave empty for email/password only.
VITE_GOOGLE_CLIENT_ID=

# Optional: a contact address sent with OpenStreetMap address lookups.
GEOCODER_CONTACT_EMAIL=

# Optional: JVM options for the backend (default -XX:MaxRAMPercentage=50,
# i.e. half of the container's 384 MB mem_limit in docker-compose.prod.yml).
# JAVA_OPTS=
