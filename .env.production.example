# Settings for docker-compose.prod.yml. Copy to .env.production, fill in, and
# keep the copy out of git (it is ignored).

# The site's address. Its DNS must point at this server before first start so
# a certificate can be issued. Use "localhost" only for a local trial.
DOMAIN=districts.example.org

# Database. Choose a long random password; the database is not reachable from
# outside the stack, but treat this as a secret anyway.
DATABASE_USER=dd
DATABASE_PASSWORD=change-me-to-a-long-random-string
DATABASE_NAME=dd

# Optional: Google sign-in client id (built into the frontend). Leave empty to
# offer email and password only.
VITE_GOOGLE_CLIENT_ID=

# Optional: a contact address sent with OpenStreetMap address lookups.
GEOCODER_CONTACT_EMAIL=

# Optional: change the published ports (defaults 80 and 443).
# HTTP_PORT=80
# HTTPS_PORT=443
