# The droplet's settings, kept on the droplet as /opt/dd/.env (see README.md,
# "Production deployment"). Copy this file there once and fill it in;
# deploy/deploy.sh never overwrites it, it only adds BACKEND_IMAGE and
# WEB_IMAGE. Leave those two out.
#
# Deploy settings (DEPLOY_HOST, IMAGE_REGISTRY, ...) go in this repo's local
# .env on your machine instead, not here.

# Database. Choose a long random password (e.g. openssl rand -base64 32); the
# database is not reachable from outside the stack, but treat this as a secret.
DATABASE_USER=dd
DATABASE_PASSWORD=change-me-to-a-long-random-string
DATABASE_NAME=dd

# Optional: Google sign-in client id; the backend only accepts tokens issued
# for it. Use the same value as VITE_GOOGLE_CLIENT_ID in your local .env (that
# one is built into the frontend). Add https://dd.lazys.net to the client's
# Authorized JavaScript origins in Google Cloud Console. Leave empty for
# email/password only.
VITE_GOOGLE_CLIENT_ID=

# Optional: a contact address sent with OpenStreetMap address lookups.
GEOCODER_CONTACT_EMAIL=

# Optional: JVM options for the backend (default -XX:MaxRAMPercentage=50,
# i.e. half of the container's 384 MB mem_limit in docker-compose.prod.yml).
# JAVA_OPTS=
