# Production image for the API: a packaged Quarkus app on a JRE, not the
# quarkus:dev server the development Dockerfile runs.
#
#   docker build -f backend/Dockerfile.prod backend
#
# (deploy/deploy.sh does this for you.)
#
# Layers are ordered from least to most often changed so a deploy only ships
# what changed: the JRE base, then the dependency jars (~60 MB, change only
# with pom.xml), then the entrypoint, then the app itself (~1.5 MB).

# --- build ------------------------------------------------------------------
FROM maven:3.9.14-eclipse-temurin-25 AS build
WORKDIR /build

# Dependencies first, so they are only re-downloaded when pom.xml changes.
COPY pom.xml ./
RUN --mount=type=cache,target=/root/.m2 mvn -B -q dependency:go-offline

COPY src ./src
# Tests run in CI / on a developer machine (they need Docker for a throwaway
# database). The container-image extension is told not to try building an
# image from inside this build.
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -q package -DskipTests -Dquarkus.container-image.build=false

# Split the dependency jars (quarkus-app/lib) out so they get their own image
# layer. The jars are byte-identical copies from the Maven repository; fixed
# timestamps make the whole layer byte-identical between builds when pom.xml
# hasn't changed, even without a build cache, so a registry already has it.
# /deps holds app/lib; the app folder entry is included and stamped too, since
# Docker records the parent folder in the layer and would otherwise use the
# copy time.
RUN mkdir -p /deps/app \
    && mv target/quarkus-app/lib /deps/app/lib \
    && find /deps -exec touch -h -d @0 {} +

# --- run --------------------------------------------------------------------
FROM eclipse-temurin:25-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1001 --home-dir /app app \
    && mkdir -p /keys && chown app:app /keys

WORKDIR /app
# Dependencies (change only with pom.xml), then the entrypoint, then the app.
COPY --from=build --chown=app:app /deps/ /
COPY --chown=app:app --chmod=755 docker/entrypoint.sh /app/entrypoint.sh
COPY --from=build --chown=app:app /build/target/quarkus-app/ ./

USER app
ENV JWT_KEY_DIR=/keys \
    QUARKUS_HTTP_HOST=0.0.0.0
# Login tokens are signed with a key pair kept here; mount a volume so it
# outlives the container.
VOLUME /keys
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
